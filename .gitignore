# Left behind by an older version of the hook, which wrote `.review/` into whatever
# directory a session was working in. The current hook writes only to the external store
# and creates nothing here, but the rule stays: it costs nothing and catches the leftovers.
.review/

__pycache__/
*.pyc
.venv/
venv/

# Copied into a repo by install.py --with-rules; it is the repo's file, not the kit's.
REVIEW-RULES.md
